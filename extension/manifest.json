{
  "manifest_version": 3,
  "name": "YT2PDF Slide Companion",
  "version": "1.0.0",
  "description": "Capture presentation slides from YouTube videos and generate clean, high-resolution study PDFs on YT2PDFS.com.",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup/popup.html",
    "default_title": "YT2PDF Slide Companion",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "scripting"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://yt2pdfs.com/*",
    "*://www.yt2pdfs.com/*",
    "https://*.run.app/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/watch*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "*://yt2pdfs.com/*",
        "*://www.yt2pdfs.com/*",
        "https://*.run.app/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "web_bridge.js"
      ],
      "run_at": "document_start"
    }
  ]
}
